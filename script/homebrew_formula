#!/usr/bin/env bash
# Writes the Homebrew formula for a release to stdout, from dist/SHA256SUMS (script/build
# --release). The release workflow commits it to webhook-hq/homebrew-tap as Formula/whq.rb.
#
#   script/homebrew_formula v1.0.0 > Formula/whq.rb
set -euo pipefail
cd "$(dirname "$0")/.."
tag=${1:?usage: script/homebrew_formula <tag, e.g. v1.0.0>}
version=${tag#v}
base="https://github.com/webhook-hq/whq-cli/releases/download/$tag"

checksum() {
  local sum
  sum=$(awk -v name="$1" '$2 == name { print $1 }' dist/SHA256SUMS)
  [ -n "$sum" ] || { echo "no checksum for $1 in dist/SHA256SUMS" >&2; exit 1; }
  echo "$sum"
}

cat <<RUBY
# Generated by script/homebrew_formula in webhook-hq/whq-cli for $tag. Don't edit by hand.
class Whq < Formula
  desc "Receive WebhookHQ webhooks on your machine and replay them into your app"
  homepage "https://webhookhq.dev/docs/cli"
  version "$version"
  license "MIT"

  on_macos do
    on_arm do
      url "$base/whq-darwin-arm64"
      sha256 "$(checksum whq-darwin-arm64)"
    end
    on_intel do
      url "$base/whq-darwin-amd64"
      sha256 "$(checksum whq-darwin-amd64)"
    end
  end

  on_linux do
    on_arm do
      url "$base/whq-linux-arm64"
      sha256 "$(checksum whq-linux-arm64)"
    end
    on_intel do
      url "$base/whq-linux-amd64"
      sha256 "$(checksum whq-linux-amd64)"
    end
  end

  def install
    bin.install Dir["whq-*"].first => "whq"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/whq --version")
  end
end
RUBY
